{
  "version": "6.1-condition-injection-v1",
  "scope": "architecture-and-forward-only-no-training",
  "max_people": 2,
  "person_axis_is_fixed": false,
  "condition_injection": {
    "input_resolution": 512,
    "output_resolution_divisor": 8,
    "normal_channels": 3,
    "pose_channels": 25,
    "part_channels": 14,
    "global_parameter_dim": 26,
    "relative_geometry_dim": 11,
    "spatial_channels": 256,
    "contact_spatial_channels": 128,
    "token_dim": 256,
    "global_tokens_per_person": 4,
    "relative_tokens": 2,
    "contact_tokens": 8,
    "use_depth": false,
    "normal_backend": "native",
    "depth_backend": "native",
    "use_full_pose_tokens": false,
    "shared_across_people": true,
    "role_binding": "film",
    "missing_human_mask_policy": "derive-from-part-onehot"
  },
  "tokens": {
    "hidden_dim": 1536,
    "geometry_per_person": 4,
    "appearance_per_person": 8,
    "relative": 2,
    "contact": 8,
    "task": 1,
    "tokenizer_is_modified": false
  },
  "dual_person_expert": {
    "cross_attention_resolution": 32,
    "cross_attention_dim": 512,
    "bidirectional": true,
    "depth_aware_scene_fusion": true,
    "directional_contact_maps": true,
    "contact_pair_tokens": true
  },
  "control_core": {
    "shared_full_width_blocks": 1,
    "stages": 6,
    "rank": 64,
    "cross_norm": true,
    "zero_residual_heads": 6
  },
  "deepgen_injection": {
    "transformer_layers": 24,
    "block_ranges": [[0, 3], [4, 7], [8, 11], [12, 15], [16, 19], [20, 22]],
    "last_block_injected": false,
    "token_layout": ["target-residual", "source-zeros", "padding-zeros"]
  },
  "parameter_policy": {
    "limit": null,
    "report_trainable_count": true
  }
}
