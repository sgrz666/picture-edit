          <mxGeometry x="35" y="1085" width="1830" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="当前代码不是把“137 维关键点”整体塞进一个 encoder：全局分支保留 25 个身体 pose heatmaps；局部分支单独取 68 脸点 + 2×21 手点，并与 SMPL-X detail 103D 编码。这样避免高维局部信号稀释全局姿态条件。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#18324A;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="85" y="1105" width="1730" height="48" as="geometry" />
